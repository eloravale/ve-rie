{
  "name": "veria",
  "description": "VÉRIA — revenue recovery infrastructure for US HVAC companies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "npm run build:worker && concurrently -k -n api,web -c yellow,cyan \"node server.mjs\" \"vite\"",
    "dev:api": "npm run build:worker && node server.mjs",
    "build": "npm run typecheck && npm run build:worker && vite build",
    "build:worker": "esbuild src/worker/index.ts --bundle --format=esm --platform=neutral --outfile=dist-worker/index.js --loader:.sql=text --legal-comments=none",
    "start": "node server.mjs",
    "preview": "npm run build && node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply veria-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply veria-db --remote"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.10.0",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "wrangler": "^4.0.0"
  }
}
